# =============================================================================
# Atrévete Bot — Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in real values for local development.
# Production values are managed via the server .env on pepe@server.
#
# CRITICAL: Never commit real secrets to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://atrevete:changeme_min16chars_secure_password@localhost:5432/atrevete_db
POSTGRES_DB=atrevete_db
POSTGRES_USER=atrevete
POSTGRES_PASSWORD=changeme_min16chars_secure_password

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# LLM (OpenRouter)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-placeholder

# ---------------------------------------------------------------------------
# Google Calendar
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=service-account-key.json
GOOGLE_CALENDAR_IDS=cal1@group.calendar.google.com,cal2@group.calendar.google.com

# ---------------------------------------------------------------------------
# Chatwoot
# ---------------------------------------------------------------------------
CHATWOOT_API_URL=https://your-chatwoot-host/
CHATWOOT_API_TOKEN=your-chatwoot-token
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1
CHATWOOT_WEBHOOK_TOKEN=your-webhook-token

# ---------------------------------------------------------------------------
# Langfuse — Observability / Tracing (OPTIONAL)
#
# These keys are only required for L2 trace-based QA audits (langfuse_pull.py).
# Leave them empty (or omit) to disable Langfuse trace capture entirely.
# The QA harness degrades gracefully: tool_evidence is still populated from
# the Redis checkpoint + DB fallback chain; only Langfuse-specific L2 checks
# are skipped when keys are absent.
#
# Get keys from: https://cloud.langfuse.com → Project Settings → API Keys
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# QA Harness — Sandbox
# ---------------------------------------------------------------------------
TEST_MODE_GCAL_SKIP=true
TEST_PHONE_PREFIX=+34999

# ---------------------------------------------------------------------------
# Admin Panel
# ---------------------------------------------------------------------------
ADMIN_USERNAME=admin@atrevete.es
ADMIN_PASSWORD=changeme
ADMIN_JWT_SECRET=changeme-min-32-chars-for-production
